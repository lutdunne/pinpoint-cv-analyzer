// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For email/password authentication
  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  dailyUsage    DailyUsage[]
  jobAnalyses   JobAnalysis[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Resume metadata
  fileName    String
  fileData    String   // Base64 encoded PDF
  parsedText  String   // Extracted text content
  
  // Analysis results
  score       Int?
  strengths   String?  // JSON array
  improvements String? // JSON array
  actionPlan  String?  // JSON array
  feedback    String?  // Full JSON feedback
  
  // Payment status
  isPaid      Boolean  @default(false)
  paymentId   String?  // Stripe payment intent ID
  paidAt      DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, createdAt])
}

model DailyUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // Store as YYYY-MM-DD string for easy comparison
  count     Int      @default(0)
  
  @@unique([userId, date])
  @@index([userId, date])
}

model JobAnalysis {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Job metadata extracted by AI
  companyName   String?
  position      String?
  jobDescription String  // Full job description
  
  // Analysis results
  matchScore    Int?     // Match percentage
  analysis      String   // Full JSON analysis feedback
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId, createdAt])
}
